# ─── SocialConnectIQ DevOps Dashboard — Environment Variables ───────────────
# Copy this file to .env and fill in your values before starting.

# ── GitHub (REQUIRED for CI/deploy actions) ──────────────────────────────────
# A Personal Access Token with: Actions (read/write) + Contents (read)
# Generate at: https://github.com/settings/tokens/new
GITHUB_TOKEN=

# GitHub org and deployment repo (defaults work for AIResearxhLabs)
GITHUB_ORG=AIResearxhLabs
DEPLOYMENT_REPO=SocialConnectIQ-deployment

# ── Production Service URLs (health polling) ─────────────────────────────────
PROD_API_GATEWAY_URL=https://api-gateway-lk7iu4bo5q-uc.a.run.app
PROD_INTEGRATION_URL=https://integration-service-lk7iu4bo5q-uc.a.run.app
PROD_AGENT_URL=https://agent-service-lk7iu4bo5q-uc.a.run.app
PROD_BACKEND_URL=https://backend-service-lk7iu4bo5q-uc.a.run.app

# ── Dashboard Settings ────────────────────────────────────────────────────────
HEALTH_POLL_INTERVAL=30
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DASHBOARD_DB_URL=sqlite:///./dashboard.db
