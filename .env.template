# SocialConnectIQ Deployment Agent - Environment Variables Template
#
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ============================================================================
# USER IDENTIFICATION
# ============================================================================

# Your email address for deployment tracking and authorization
# This is used to determine your role and permissions
DEPLOYMENT_USER=your-email@company.com

# ============================================================================
# GOOGLE CLOUD PLATFORM (for staging/production deployments)
# ============================================================================

# GCP Project IDs
GCP_PROJECT_ID_STAGING=socialconnectiq-staging
GCP_PROJECT_ID_PROD=socialconnectiq-prod

# GCP Region
GCP_REGION=us-central1

# Path to GCP service account key file (for local testing)
# In production, use Workload Identity or ADC
GOOGLE_APPLICATION_CREDENTIALS=./credentials/gcp-service-account.json

# ============================================================================
# FIREBASE (for frontend deployment)
# ============================================================================

# Firebase projects
FIREBASE_PROJECT_STAGING=socialconnectiq-staging
FIREBASE_PROJECT_PROD=socialconnectiq-prod

# Firebase token (optional - for CI/CD)
# Generate with: firebase login:ci
FIREBASE_TOKEN=

# ============================================================================
# DOCKER (for local deployment)
# ============================================================================

# Docker Desktop configuration
DOCKER_HOST=unix:///var/run/docker.sock
COMPOSE_PROJECT_NAME=socialconnectiq

# Docker build options
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# ============================================================================
# NOTIFICATIONS (optional)
# ============================================================================

# Slack webhooks
SLACK_WEBHOOK_STAGING=https://hooks.slack.com/services/YOUR/STAGING/WEBHOOK
SLACK_WEBHOOK_PROD=https://hooks.slack.com/services/YOUR/PROD/WEBHOOK

# Email configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@company.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=deployments@company.com

# PagerDuty (for production alerts)
PAGERDUTY_KEY=your-integration-key

# ============================================================================
# LANGGRAPH / AI (optional - for intelligent decision-making)
# ============================================================================

# OpenAI API key (if using LLM-powered agents)
OPENAI_API_KEY=sk-your-api-key

# LangSmith (for tracing and debugging)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=socialconnectiq-deployment

# ============================================================================
# GITHUB (optional - for CI/CD integration)
# ============================================================================

# GitHub Personal Access Token (for triggering workflows)
GITHUB_TOKEN=ghp_your_token
GITHUB_ORG=AIResearxhLabs
GITHUB_REPO=SocialConnectIQ

# ============================================================================
# DEPLOYMENT SETTINGS
# ============================================================================

# Default environment if not specified
DEFAULT_ENVIRONMENT=local

# Enable dry run mode (simulate without actual deployment)
DRY_RUN=false

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log directory
LOG_DIRECTORY=./logs

# Deployment timeout (seconds)
DEPLOYMENT_TIMEOUT=1800

# ============================================================================
# SECURITY
# ============================================================================

# Enable audit logging
ENABLE_AUDIT_LOG=true

# Require approval for all deployments (override environment config)
FORCE_APPROVAL=false

# Maximum concurrent deployments
MAX_CONCURRENT_DEPLOYMENTS=3

# ============================================================================
# PATHS (relative to deployment repository)
# ============================================================================

# Path to main SocialConnectIQ repository
MAIN_REPO_PATH=../SocialConnectIQ

# Path to frontend repository
FRONTEND_REPO_PATH=../SocialConnectIQ-frontend

# Path to configuration files
CONFIG_DIR=./config

# ============================================================================
# DEVELOPMENT / TESTING
# ============================================================================

# Enable debug mode
DEBUG=false

# Skip health checks (for testing only)
SKIP_HEALTH_CHECKS=false

# Skip validation (for testing only)
SKIP_VALIDATION=false

# Mock external services (for testing)
MOCK_GCP=false
MOCK_FIREBASE=false
MOCK_DOCKER=false